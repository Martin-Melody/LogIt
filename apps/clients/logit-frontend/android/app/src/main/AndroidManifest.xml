<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustNothing"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- A CSV shared from another app (Strong's or Hevy's export, a spreadsheet) or opened
                 with LogIt: the import screen opens on it (SharedFilePlugin). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="text/x-csv" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="text/x-csv" />
            </intent-filter>

            <!-- Shared algorithms: the "Open in LogIt" button on getlogit.app/a opens logit://a?c=<code>. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="logit" android:host="a" />
            </intent-filter>

            <!-- The share link itself (https://getlogit.app/a#<code>). Opens the app directly once
                 getlogit.app/.well-known/assetlinks.json lists the Play signing key; until then
                 it opens the web page, which has the button above. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="getlogit.app" android:path="/a" />
            </intent-filter>

            <!-- A friend's invite: the website's "Open in LogIt" (logit://f?c=logit-fr1:…) and, once
                 App Links are verified, the link itself (https://getlogit.app/f#logit-fr1:…). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="logit" android:host="f" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="getlogit.app" android:path="/f" />
            </intent-filter>
            <!-- A group's link (canvas G10): the website's "Open in LogIt" (logit://g?c=logit-gr1:…)
                 and, once App Links are verified, https://getlogit.app/g#logit-gr1:…. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="logit" android:host="g" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="getlogit.app" android:path="/g" />
            </intent-filter>
            <!-- A profile or post on the web (canvas row 18): the website's "Open in LogIt"
                 (logit://u/ava[/p/<id>]) and, once App Links are verified, getlogit.app/@ava. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="logit" android:host="u" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="getlogit.app" android:pathPrefix="/@" />
            </intent-filter>
            <!-- A forum post or a tag on the web (canvas F4): getlogit.app/forum/<slug>-<id> and
                 getlogit.app/t/<tag> open the same screens in the app. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="getlogit.app" android:pathPrefix="/forum/" />
                <data android:scheme="https" android:host="getlogit.app" android:pathPrefix="/t/" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Music bar: lets LogIt see and control the music app that's playing (media sessions).
             Android only allows that for an enabled notification listener; the service is empty
             and never reads notifications. The user switches it on in Notification access. -->
        <service
            android:name=".MediaListenerService"
            android:label="@string/app_name"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Pre-download the ML Kit barcode scanner (Google code scanner) module
             so the native scan() UI is ready on first use. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <!-- Pushes (Firebase): the LogIt status-bar icon, and the Social channel for any push
             that names none. The app makes the channels (lib/platform/push.ts). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_logit" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="social" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera plugin: take a photo (avatar, progress photo, meal photo, nutrition-label OCR).
         Gallery selection goes through the Android photo picker (PickVisualMedia) which needs
         no storage/media permission, so READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE are
         deliberately NOT declared — Google Play's Photo and Video Permissions policy wants
         infrequent, user-initiated image access to use the picker rather than a broad grant. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Voice messages: the WebView records with getUserMedia, which Capacitor turns into a
         RECORD_AUDIO request the first time the mic is tapped (never in the background). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Rest-timer fallback notification when the app is backgrounded. SCHEDULE_EXACT_ALARM is
         also declared by @capacitor/local-notifications; on API 33 it is granted by default, on
         API 34+ the timer falls back to an inexact alarm unless the user grants it. USE_EXACT_ALARM
         is deliberately NOT declared — Play restricts it to alarm-clock / timer / calendar apps. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Music bar: see which music apps are installed (to open a playlist link in the right one)
         and read the name of the app that's playing. -->
    <queries>
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.youtube.music" />
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>
</manifest>
