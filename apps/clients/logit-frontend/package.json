{
  "name": "logit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "android:sync:dev": "npm run build && npx cap sync android && npm run dev -- --host 0.0.0.0 --port 3000",
    "android:live": "npx cap run android --live-reload --host 10.200.0.2 --port 3000",
    "android:dev": "npm run dev -- --host 0.0.0.0 --port 3000"
  },
