    { "name": "Adductor Rock-Back", "area": "adductors", "defaultMetric": "hold", "perSide": true, "cues": ["Long spine", "Rock the hips back to tolerance"] },
    { "name": "Prone Hip Internal Rotation", "area": "hips", "defaultMetric": "hold", "perSide": true, "cues": ["Knees wide, shins fall in", "Relax into the range"] },
    { "name": "Half-Kneeling Hip Flexor Stretch", "area": "hip-flexors", "defaultMetric": "hold", "perSide": true, "cues": ["Posterior pelvic tilt", "Squeeze the down-side glute"] },
