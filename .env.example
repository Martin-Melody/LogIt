# Copy to .env and fill in before running `docker compose up`.

# Random 32+ char secret used to sign auth tokens. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Sets the server up: open the web dashboard and create your account with this key (instead of
# an invite) and that account becomes the admin (Admin in the account menu: people, invites,
# reports, server). Also works as X-Admin-Key for scripts, e.g. the nightly backup on the
# Server page. It unlocks every account, so make it long and random. Generate one with:
#   openssl rand -base64 32
# Ten wrong keys from one address lock that address out for 15 minutes.
ADMIN_KEY=

# Who can create an account: "invite" (default: an invite code from Admin › Invites is needed)
# or "open" (anyone who can reach the server). Keep "invite" if the server is on the internet.
# Admin › Server can change it later; that choice then wins over this one.
REGISTRATION_MODE=invite

# Public URL the web app is served from — required by SvelteKit for CSRF checks, and used
# by the API to build links (e.g. password reset emails) that point back at the web app.
# Change this if you're hosting behind a domain instead of localhost.
WEB_ORIGIN=http://localhost:3000

# Where the web dashboard finds the API, so nobody has to pick "use your own server" when signing
# in on the web. The default ":8080" means "the same host the dashboard is opened on, port 8080",
# which works for http://localhost:3000 and http://<server-ip>:3000. Behind a reverse proxy, set
# the API's public address, e.g. https://logit-api.example.org
API_URL=:8080

# Optional: the commit this server was built from, shown on the admin console's Server page.
# Set it when building: LOGIT_COMMIT=$(git rev-parse --short HEAD) docker compose up -d --build
LOGIT_COMMIT=

# Optional: SMTP relay for transactional email (currently just password reset). Leave blank
# to disable — the API responds with a clear "not configured" message instead of failing
# silently, and admins can still reset a password from the person's page in Admin › People.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
