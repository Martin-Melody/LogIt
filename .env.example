# Copy to .env and fill in before running `docker compose up`.

# Random 32+ char secret used to sign auth tokens. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Key required to access the admin endpoints/dashboard. Pick your own value.
ADMIN_KEY=

# Public URL the web app is served from — required by SvelteKit for CSRF checks, and used
# by the API to build links (e.g. password reset emails) that point back at the web app.
# Change this if you're hosting behind a domain instead of localhost.
WEB_ORIGIN=http://localhost:3000

# Optional: SMTP relay for transactional email (currently just password reset). Leave blank
# to disable — the API responds with a clear "not configured" message instead of failing
# silently, and you can still reset a user's password manually via the admin panel/API
# (POST /admin/api/users/{id}/reset-password with X-Admin-Key).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
