{
  "ConnectionStrings": {
    "Default": "Data Source=logit.db"
  },
  "Deployment": {
    "SelfHosted": false
  },
  "Admin": {
    "Key": ""
  },
  "Registration": {
    "Mode": "open"
  },
  "Jwt": {
    "Issuer": "logit-api",
    "Audience": "logit-app",
    "AccessTokenMinutes": "15",
    "RefreshTokenDays": "30"
  },
  "Billing": {
    "WebCheckout": false
  },
  "GooglePlay": {
    "PackageName": "ie.logit.app",
    "ProProductId": "logit_pro",
    "StudioProductId": "logit_studio",
    "ServiceAccountJson": "",
    "ServiceAccountKeyFile": "",
    "NotificationToken": ""
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": "",
    "ProPriceId": "",
    "StudioPriceId": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "None",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "logit",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*"
}
