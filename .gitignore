android/app/src/main/assets/capacitor.plugins.json
apps/clients/logit-frontend/android/app/src/main/assets/databases/*.db  # bundled food.db, dropped in by the release build
android/local.properties
android/*.iml
android/.idea/
*.keystore
*.jks

