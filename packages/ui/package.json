{
  "name": "@logit/ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "LogIt's shared look: theme (colours, Inter, radius) and brand components, used by the app, the dashboard and the website.",
  "exports": {
    "./theme.css": "./src/theme.css",
    "./Logo.svelte": {
      "types": "./src/Logo.svelte",
      "svelte": "./src/Logo.svelte",
      "default": "./src/Logo.svelte"
    },
    "./fonts/*": "./fonts/*",
    "./ImageCropper.svelte": {
      "types": "./src/ImageCropper.svelte",
      "svelte": "./src/ImageCropper.svelte",
      "default": "./src/ImageCropper.svelte"
    }
  },
  "files": [
    "src",
    "fonts"
  ],
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@logit/core": "*"
  }
}
