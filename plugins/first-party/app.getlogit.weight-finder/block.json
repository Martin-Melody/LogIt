{
  "id": "app.getlogit.weight-finder",
  "name": "Weight finder",
  "description": "Work up to the weight that fits: a jump at a time, until you could only have done 1 or 2 more reps. Each jump is a set of the lift.",
  "icon": "dumbbell",
  "entry": { "one": "Jump", "many": "Jumps" },
  "blockFields": [
    { "key": "lift", "type": "exercise", "label": "Lift" }
  ],
  "fields": [
    { "key": "kg", "type": "weight", "label": "kg", "column": true },
    { "key": "reps", "type": "number", "label": "Reps", "default": 6, "step": 1, "min": 1, "max": 20, "column": true },
    { "key": "left", "type": "choice", "label": "How many more could you have done?", "options": ["0", "1", "2", "3", "4+"], "column": true }
  ],
  "summary": "{count} jumps",
  "countsAs": { "sets": { "exercise": "lift", "weight": "kg", "reps": "reps", "rir": "left" } }
}
